# Скопируйте файл в .env. Значения секретов не коммитьте.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Для streamable HTTP. При stdio оставьте пустым.
MCP_SERVER_URL=

# MCP-сервер OLGA (участник 2). Сервер НЕ читает .env сам: задайте переменные
# в оболочке или передайте их клиентом в StdioServerParameters(env=...).
# Подробно: docs/olga_adapter.md
OLGA_ADAPTER_MODE=            # real или fake (fake — только тестовый fake_olga)
OLGA_CASE_KIT_DIR=            # каталог комплекта модели ВНЕ репозитория
OLGA_LAUNCHER=                # проверенный исполняемый файл OLGA
OLGA_LAUNCHER_ARGS=           # JSON-список, например ["{input}"] — проверить по установке
OLGA_APPROVAL_SECRET=         # общий секрет CLI и сервера; не коммитить, не давать LLM
OLGA_RUNS_ROOT=               # по умолчанию well-agent/runs
OLGA_LOG_DIR=                 # по умолчанию well-agent/logs
OLGA_RUN_TIMEOUT_S=3600
OLGA_MAX_CONCURRENT_RUNS=1
OLGA_LICENSE_ERROR_PATTERNS=  # JSON-список regex по реальным сообщениям OLGA
OLGA_NO_SOLUTION_PATTERNS=
