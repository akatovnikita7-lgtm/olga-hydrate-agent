# Скопируйте файл в .env. Значения секретов не коммитьте.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Для streamable HTTP. При stdio оставьте пустым.
MCP_SERVER_URL=

# Настройки локального адаптера к инженерному ПО.
SIMULATOR_NAME=
SIMULATOR_MODEL_PATH=

# MCP-сервер OLGA (участник 2). Подробно: docs/olga_adapter.md
# Строку OLGA_APPROVAL_SECRET= не меняйте вручную: setup.cmd (scripts/init_config.py)
# сам запишет туда случайный секрет. Не коммитьте .env и не отправляйте секрет в чат.
OLGA_ADAPTER_MODE=real
OLGA_CASE_KIT_DIR=
OLGA_LAUNCHER=
OLGA_LAUNCHER_ARGS=
OLGA_APPROVAL_SECRET=
OLGA_RUN_TIMEOUT_S=3600
OLGA_MAX_CONCURRENT_RUNS=1
OLGA_LICENSE_ERROR_PATTERNS=
OLGA_NO_SOLUTION_PATTERNS=
